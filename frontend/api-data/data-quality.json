{
  "domain": "data-quality",
  "parentDomain": "domain-configuration",
  "backend": "DATAQUALITY",
  "backendBasePath": "/api/decisionops-pod1/p0/dataQuality",
  "gatewayHost": "http://172.16.0.12/api/decisionops-pod1",
  "auth": {
    "scheme": "cookie + bearer (dual)",
    "cookies": ["access_token", "auth_token"],
    "note": "Authorization: Bearer and Cookie: access_token forwarded by local proxy."
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/decisionops-pod1/p0/dataQuality/dataquality/analyze",
      "fullUrlSample": "http://172.16.0.12/api/decisionops-pod1/p0/dataQuality/dataquality/analyze?plant_code_id=plant_1",
      "contentType": "application/json",
      "description": "Fetch all numeric IoTDB data and run timeseries quality analysis for a given plant.",
      "requestFields": {
        "plant_code_id": {
          "placement": "query",
          "confirmed": true,
          "description": "Plant identifier"
        }
      },
      "serviceFn": "analyzeDataQuality(plant_code)",
      "serviceFile": "src/services/domain-configuration/common/dataQualityService.js",
      "proxyRoute": "src/app/api/domain-configuration/timeseries/data-quality/analyze/route.js",
      "queryHook": "useDataQuality(plantCode) in src/components/admin/_queries/useDsiQueries.js",
      "queryKey": "['domain-config', plantCode, 'data-quality']"
    }
  ]
}
