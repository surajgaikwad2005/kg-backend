{
  "domain": "agent-factory",
  "lastUpdated": "2026-07-10",
  "backend": {
    "logicalName": "AGENT_FACTORY",
    "envVar": "SERVICE_AGENT_FACTORY_URL",
    "envVarValue": "bare host only, e.g. http://172.16.0.12 (no path)",
    "gatewayPrefix": "/api/decisionops-pod1/p1/agentFactory",
    "resolvedBaseUrl": "http://172.16.0.12/api/decisionops-pod1/p1/agentFactory",
    "backendPathsEntry": "src/app/api/_lib/backends.js -> agentFactoryPrefix() / BACKEND_PATHS",
    "responseEnvelope": "{ success: boolean, message: string, data: object|array|null }",
    "authHeadersDocumented": ["access_token", "refresh_token"],
    "authHeadersActuallySent": "Authorization: Bearer <token> AND Cookie: access_token=<token> (see CLAUDE.md API rule 3) — injected globally, never per-route",
    "plantField": {
      "name": "plant_code_id",
      "note": "Sent as query parameters for GET and DELETE requests, and in the body for POST and PUT requests."
    },
    "notes": [
      "Catch-all proxy route (src/app/api/agent-factory/[...path]/route.js) forwards requests to the AGENT_FACTORY backend.",
      "The proxy extracts the user identity from JWT tokens and maps it to X-User-ID header."
    ]
  },
  "serviceFile": "src/services/agent-factory/agentFactoryService.js",
  "proxyRoute": "src/app/api/agent-factory/[...path]/route.js",
  "localProxyBase": "/api/agent-factory",
  "endpoints": [
